[Unit]
Description=HYPE Lens real-time price alert service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hype-alert
Group=hype-alert
EnvironmentFile=/etc/hype-lens/alert.env
ExecStart=/usr/bin/python3 /opt/hype-lens/price_alert_service.py
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hype-lens

[Install]
WantedBy=multi-user.target
